{
  "format": "page",
  "id": "blog_post",
  "label": "blog post",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "UID"
        }
      },
      "listing_title": {
        "type": "Text",
        "config": {
          "label": "Listing Title",
          "placeholder": ""
        }
      },
      "listing_excerpt": {
        "type": "Text",
        "config": {
          "label": "Listing Excerpt",
          "placeholder": ""
        }
      },
      "thumbnail": {
        "type": "Image",
        "config": {
          "label": "Thumbnail",
          "constraint": {},
          "thumbnails": []
        }
      },
      "category": {
        "type": "Text",
        "config": {
          "label": "Category",
          "placeholder": ""
        }
      },
      "reading_time": {
        "type": "Text",
        "config": {
          "label": "Reading Time",
          "placeholder": ""
        }
      },
      "author_name": {
        "type": "Text",
        "config": {
          "label": "Author Name",
          "placeholder": ""
        }
      },
      "featured": {
        "type": "Boolean",
        "config": {
          "label": "Featured",
          "placeholder_false": "false",
          "placeholder_true": "true",
          "default_value": false
        }
      },
      "display_order": {
        "type": "Number",
        "config": {
          "label": "Display Order",
          "placeholder": ""
        }
      },
      "slices": {
        "type": "Slices",
        "fieldset": "Slice Zone",
        "config": {
          "choices": {
            "blog_image": {
              "type": "SharedSlice"
            },
            "blog_cta": {
              "type": "SharedSlice"
            },
            "blog_text": {
              "type": "SharedSlice"
            },
            "blog_hero": {
              "type": "SharedSlice"
            }
          }
        }
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "config": {
          "label": "Meta Title",
          "placeholder": "A title of the page used for social media and search engines"
        },
        "type": "Text"
      },
      "meta_description": {
        "config": {
          "label": "Meta Description",
          "placeholder": "A brief summary of the page"
        },
        "type": "Text"
      },
      "meta_image": {
        "config": {
          "constraint": {
            "height": 1260,
            "width": 2400
          },
          "label": "Meta Image",
          "thumbnails": []
        },
        "type": "Image"
      }
    }
  }
}
