# ==============================================================================
# Email Configuration (Nodemailer)
# ==============================================================================

# ------------------------------------------------------------------------------
# OPTION 1: Custom Domain Email (e.g., Nameslink / Namecheap / cPanel / Webmail)
# ------------------------------------------------------------------------------
# The outgoing SMTP server hostname provided by your email host:
EMAIL_HOST=mail.sattarwebstudio.com
# Port 465 (SSL, EMAIL_SECURE=true) or Port 587 (TLS, EMAIL_SECURE=false)
EMAIL_PORT=465
EMAIL_SECURE=true
# Your custom mailbox email address:
EMAIL_USER=hello@sattarwebstudio.com
# Your email mailbox password:
EMAIL_PASS=your_mailbox_password_here

# (Optional) If you want contact form submissions forwarded to a different personal inbox:
# EMAIL_TO=yourpersonal@gmail.com


# ------------------------------------------------------------------------------
# OPTION 2: Personal Gmail (Fallback)
# ------------------------------------------------------------------------------
# If EMAIL_HOST is left empty, the application falls back to Gmail.
# EMAIL_USER=yourgmail@gmail.com
# EMAIL_PASS=your_google_app_password

# ==============================================================================
# Prismic Webhook Revalidation (/api/revalidate)
# ==============================================================================
# (Optional) Secret key to secure /api/revalidate against unauthorized calls.
# Set this same secret value in your Prismic repository under Settings > Webhooks.
PRISMIC_WEBHOOK_SECRET=your_prismic_webhook_secret_here

